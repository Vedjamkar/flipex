<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- macOS 15+: finding the phone over Wi-Fi (wireless debugging) needs Local Network access. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>FlipEx finds and connects to your phone over Wi-Fi (wireless debugging) on your local network.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_adb-tls-connect._tcp</string>
    <string>_adb-tls-pairing._tcp</string>
  </array>
</dict>
</plist>
