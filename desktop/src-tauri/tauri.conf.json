{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlipEx",
  "version": "0.3.1",
  "identifier": "dev.ved.flipex.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FlipEx",
        "width": 400,
        "height": 600,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/scrcpy/": "scrcpy/"
    },
    "copyright": "FlipEx contributors. Bundles scrcpy (Apache-2.0) and Android adb.",
    "category": "Utility",
    "shortDescription": "Samsung DeX from your Galaxy Z Flip, in a window",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
